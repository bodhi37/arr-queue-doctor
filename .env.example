# Copy to your environment / systemd override. The script reads real env vars.
# SONARR_URL=http://127.0.0.1:8989/api/v3
# RADARR_URL=http://127.0.0.1:7878/api/v3
# QBIT_URL=http://127.0.0.1:8080/api/v2
# Prefer keys directly; otherwise set the config.xml paths below.
# SONARR_API_KEY=
# RADARR_API_KEY=
# SONARR_CONFIG=/var/lib/sonarr/config.xml
# RADARR_CONFIG=/var/lib/radarr/config.xml
# ARR_QUEUE_DOCTOR_META_TIMEOUT=1800
# ARR_QUEUE_DOCTOR_STALL_TIMEOUT=5400
# ARR_QUEUE_DOCTOR_MAX_RECOVERIES=2
# ARR_QUEUE_DOCTOR_HTTP_TIMEOUT=90
# ARR_QUEUE_DOCTOR_LOG=/var/lib/arr-queue-doctor/recovery-events.jsonl
# Comma-separated qBittorrent tags to leave alone (e.g. managed by a router).
# Empty = consider every matching torrent.
# ARR_QUEUE_DOCTOR_SKIP_TAGS=route_error,route_import_failed,route_overcommit,route_waiting_space
# ARR_QUEUE_DOCTOR_DRY_RUN=0
